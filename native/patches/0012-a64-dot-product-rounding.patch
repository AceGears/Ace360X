+// The float64 sum converted to single rounding toward zero, as upstream's
+// x64 default (use_fast_dot_product) does; the console matches this in about
+// 97% of cases (x64's EmitVectorMultiplySum is the exact model). A sum that
+// overflows single when rounded to nearest stays infinite for the caller's
+// overflow check.
+static float DotProductToSingle(double sum) {
+  float nearest = static_cast<float>(sum);
+  if (std::isinf(nearest) || std::isnan(nearest)) {
+    return nearest;
+  }
+  if (std::fabs(static_cast<double>(nearest)) > std::fabs(sum)) {
+    return std::nextafter(nearest, 0.0f);
+  }
+  return nearest;
+}
