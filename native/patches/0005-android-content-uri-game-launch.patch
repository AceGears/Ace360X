 FILE* OpenFile(const std::filesystem::path& path, const std::string_view mode) {
+#if XE_PLATFORM_ANDROID
+  // Ace360X: Storage Access Framework documents.
+  if (IsAndroidContentUri(path.string())) {
+    const std::string mode_str(mode);
+    const bool write = mode_str.find_first_of("wa+") != std::string::npos;
+    int fd = OpenAndroidContentFileDescriptor(path.string(), write ? "rw" : "r");
+    if (fd < 0) {
+      return nullptr;
+    }
+    FILE* file = fdopen(fd, mode_str.c_str());
+    if (!file) {
+      close(fd);
+    }
+    return file;
+  }
+#endif  // XE_PLATFORM_ANDROID
   return fopen(path.c_str(), std::string(mode).c_str());
 }
 
