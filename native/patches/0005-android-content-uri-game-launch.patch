 namespace filesystem {
 
+bool IsNonHostPath(const std::filesystem::path& path) {
+#if XE_PLATFORM_ANDROID
+  return IsAndroidContentUri(path.string());
+#else
+  (void)path;
+  return false;
+#endif
+}
+
+bool PathExistsAnyScheme(const std::filesystem::path& path) {
+#if XE_PLATFORM_ANDROID
+  if (IsAndroidContentUri(path.string())) {
+    int fd = OpenAndroidContentFileDescriptor(path.string(), "r");
+    if (fd < 0) {
+      return false;
+    }
+    close(fd);
+    return true;
+  }
+#endif
+  std::error_code ec;
+  return std::filesystem::exists(path, ec);
+}
+
+std::optional<uint64_t> FileSizeAnyScheme(const std::filesystem::path& path) {
+#if XE_PLATFORM_ANDROID
+  if (IsAndroidContentUri(path.string())) {
+    int fd = OpenAndroidContentFileDescriptor(path.string(), "r");
+    if (fd < 0) {
+      return std::nullopt;
+    }
+    struct stat st = {};
+    const bool ok = fstat(fd, &st) == 0;
+    close(fd);
+    if (!ok || st.st_size < 0) {
+      return std::nullopt;
+    }
+    return uint64_t(st.st_size);
+  }
+#endif
+  std::error_code ec;
+  const uintmax_t size = std::filesystem::file_size(path, ec);
+  if (ec) {
+    return std::nullopt;
+  }
+  return uint64_t(size);
+}
