 void SpirvShaderTranslator::StartFragmentShaderInMain() {
+  // Ace360X (patch 0021): gl_SampleMask is declared for every non-FSI color
+  // shader, but was written only by the alpha-to-coverage code, which is
+  // skipped with early fragment tests or when color target 0 isn't written.
+  // An output that is declared but not written is undefined in Vulkan; the
+  // Qualcomm Adreno 840 driver treats it as zero coverage and drops every
+  // fragment. Start with full coverage on all paths.
+  if (output_fragment_sample_mask_ != spv::NoResult &&
+      cvars::ace_ps_init_sample_mask) {
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(builder_->makeIntConstant(0));
+    builder_->createStore(
+        builder_->makeIntConstant(-1),
+        builder_->createAccessChain(spv::StorageClassOutput,
+                                    output_fragment_sample_mask_,
+                                    id_vector_temp_));
+  }
+
