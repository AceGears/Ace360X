diff --git a/cmake/XeniaHelpers.cmake b/cmake/XeniaHelpers.cmake
index 0b647d3..edc3cde 100644
--- a/cmake/XeniaHelpers.cmake
+++ b/cmake/XeniaHelpers.cmake
@@ -63,6 +63,13 @@ function(xe_platform_sources target base_path)
     file(${glob_mode} _plat_sources      "${base_path}/*_win.h"
       "${base_path}/*_win.cc"
     )
+  elseif(ANDROID)
+    # Ace360X: Android uses the POSIX layer plus *_android files.
+    file(${glob_mode} _plat_sources      "${base_path}/*_posix.h"
+      "${base_path}/*_posix.cc"
+      "${base_path}/*_android.h"
+      "${base_path}/*_android.cc"
+    )
   elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
     file(${glob_mode} _plat_sources      "${base_path}/*_posix.h"
       "${base_path}/*_posix.cc"
@@ -127,8 +134,9 @@ function(xe_target_defaults target)
         source_group(TREE ${PROJECT_SOURCE_DIR} PREFIX "External" FILES ${_external_srcs})
       endif()
     endif()
-  elseif(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+  elseif(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT XENIA_DISABLE_WERROR)
     # GCC is too noisy for -Werror; only apply to Clang
+    # (Ace360X: XENIA_DISABLE_WERROR lets Android builds log warnings instead.)
     target_compile_options(${target} PRIVATE -Werror)
   endif()
 endfunction()
