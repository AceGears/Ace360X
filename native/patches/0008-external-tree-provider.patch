+// Ace360X: optional provider for virtual directory trees addressed as
+// "<scheme>://<root>/<relative path>" (on Android: Storage Access Framework
+// folders), so HostPathDevice can mount folders that have no POSIX path.
+// GetInfo, ListFiles, FileHandle::OpenExisting, OpenFile and
+// MappedMemory::Open route matching paths to the provider.
+struct ExternalTreeProvider {
+  const char* scheme;  // e.g. "acetree"
+  std::optional<FileInfo> (*get_info)(const std::filesystem::path& path);
+  std::vector<FileInfo> (*list_files)(const std::filesystem::path& path);
+  // Returns a file descriptor owned by the caller, or -1 on failure.
+  int (*open_fd)(const std::filesystem::path& path, bool write);
+};
+void SetExternalTreeProvider(const ExternalTreeProvider* provider);
+// The provider handling this path, or nullptr for ordinary paths.
+const ExternalTreeProvider* ExternalTreeProviderFor(
+    const std::filesystem::path& path);
+
 #if XE_PLATFORM_ANDROID
 void AndroidInitialize();
 void AndroidShutdown();
