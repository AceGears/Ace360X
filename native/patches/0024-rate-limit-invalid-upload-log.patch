@@ -425,9 +425,16 @@ bool VulkanSharedMemory::UploadRanges(
                                                        range_end_addr);
       if (start_access == xe::memory::PageAccess::kNoAccess ||
           end_access == xe::memory::PageAccess::kNoAccess) {
-        XELOGE(
