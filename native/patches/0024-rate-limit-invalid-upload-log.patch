diff --git a/src/xenia/gpu/vulkan/vulkan_shared_memory.cc b/src/xenia/gpu/vulkan/vulkan_shared_memory.cc
index fe8dc64..cd50dde 100644
--- a/src/xenia/gpu/vulkan/vulkan_shared_memory.cc
