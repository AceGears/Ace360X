diff --git a/src/xenia/gpu/ace_frame_stats.h b/src/xenia/gpu/ace_frame_stats.h
new file mode 100644
index 0000000..a1b1015
--- /dev/null
+++ b/src/xenia/gpu/ace_frame_stats.h
@@ -0,0 +1,69 @@
+// Ace360X (patch 0023): guest frame interval recorder for on-device
+// performance measurement. Header-only so no build file changes are needed.
+#ifndef XENIA_GPU_ACE_FRAME_STATS_H_
+#define XENIA_GPU_ACE_FRAME_STATS_H_
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+namespace xe {
+namespace gpu {
+namespace ace {
+
+// Intervals between consecutive guest swaps (frames the game finished), in
+// microseconds. Written by the GPU command processor thread, drained by the
+// host UI about once a second. Holds a little over 4 s at 60 swaps/s; if the
+// reader is slower, the oldest intervals are overwritten.
+class FrameStats {
+ public:
+  static constexpr size_t kCapacity = 256;
+
+  void RecordSwap() {
+    uint64_t now_us = uint64_t(
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (last_swap_us_) {
+      uint64_t interval = now_us - last_swap_us_;
+      intervals_[(first_ + count_) % kCapacity] =
+          interval > UINT32_MAX ? UINT32_MAX : uint32_t(interval);
+      if (count_ < kCapacity) {
+        ++count_;
+      } else {
+        first_ = (first_ + 1) % kCapacity;
+      }
+    }
+    last_swap_us_ = now_us;
+  }
+
+  // Copies up to max_count pending intervals (oldest first) and clears them.
+  size_t Drain(uint32_t* out, size_t max_count) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t n = count_ < max_count ? count_ : max_count;
+    for (size_t i = 0; i < n; ++i) {
+      out[i] = intervals_[(first_ + i) % kCapacity];
+    }
+    first_ = 0;
+    count_ = 0;
+    return n;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::array<uint32_t, kCapacity> intervals_{};
+  size_t first_ = 0;
+  size_t count_ = 0;
+  uint64_t last_swap_us_ = 0;
+};
+
+inline FrameStats g_frame_stats;
+
+}  // namespace ace
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_ACE_FRAME_STATS_H_
