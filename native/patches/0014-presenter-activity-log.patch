+  {
+    // Ace360X (patch 0014): presentation summary for device diagnostics, at
+    // most every 5 s while painting happens.
+    static uint64_t counts[6] = {};
+    static uint64_t last_report_ms = 0;
+    static uint64_t total = 0;
+    ++total;
+    size_t index = size_t(result);
+    if (index < 6) {
