# Generates version.h (normally written by upstream's xenia-build.py) into the
# top build directory, which upstream adds to its include path.
find_package(Git REQUIRED)
set(_up "${CMAKE_CURRENT_LIST_DIR}/../xenia-upstream")
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
  WORKING_DIRECTORY "${_up}" OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
  WORKING_DIRECTORY "${_up}" OUTPUT_VARIABLE _short OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT _commit)
  set(_commit "unknown")
  set(_short "unknown")
endif()
set(_content "// Generated by Ace360X native/cmake/XeniaVersion.cmake\n\
#ifndef GENERATED_VERSION_H_\n#define GENERATED_VERSION_H_\n\
#define XE_BUILD_BRANCH \"canary_experimental (Ace360X)\"\n\
#define XE_BUILD_COMMIT \"${_commit}\"\n\
#define XE_BUILD_COMMIT_SHORT \"${_short}\"\n\
#define XE_BUILD_DATE __DATE__\n\
#endif  // GENERATED_VERSION_H_\n")
file(WRITE "${CMAKE_BINARY_DIR}/version.h.tmp" "${_content}")
configure_file("${CMAKE_BINARY_DIR}/version.h.tmp" "${CMAKE_BINARY_DIR}/version.h" COPYONLY)
